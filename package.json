{
  "name": "@webship.co/workspace-ghost",
  "version": "1.0.7",
  "description": "Ghost for Webship Workspace: the builder (`cmd-ghost-project.sh`) and the Ghost-CLI tool in every sites folder, the default staff accounts, the Ghost step pack wired into the testing setup, and two AI agents in the AI Agents folder.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-ghost.git"
  },
  "files": [
    "dist/src",
    "agents",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "ghost",
    "label": "Ghost",
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-ghost-project.sh",
        "commands/cmd-tools-ghost-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-ghost.sh"
      ],
      "args": [
        "scripts/args/arg-ghost.sh",
        "scripts/args/arg-ghost-cli.sh"
      ],
      "machine": [
        "scripts/ghost-accounts.js",
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "agents/ghost-site-builder.md",
        "agents/ghost-tester.md"
      ]
    },
    "features": [
      "features/ghost.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.7",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
